# Root "examples" folder of your Veins checkout. The bridge recursively
# discovers every "<scenario>/results/live" folder under this path and
# automatically follows whichever one most recently started producing
# events. You do NOT point this at one specific scenario, and you never
# edit this file to switch scenarios -- run any scenario you like and the
# dashboard picks it up on its own.
#
# Example (Windows):
# VEINS_EXAMPLES_ROOT=C:\Users\you\veins-5.3.1\veins-veins-5.3.1\examples
VEINS_EXAMPLES_ROOT=

# Port the bridge server listens on (dashboard connects to ws://<host>:<PORT>/ws)
PORT=8080
